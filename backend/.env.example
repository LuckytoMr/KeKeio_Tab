FULLPRO_ADDR=:9009
FULLPRO_DB=/data/fullpro.db
# This startup override takes precedence over the directory saved by the
# installation wizard and is verified writable before the server starts.
FULLPRO_BACKUP_DIRECTORY=/backups
FULLPRO_HEALTHCHECK_URL=http://127.0.0.1:9009/health/live
FULLPRO_COOKIE_NAME=fullpro_session
FULLPRO_COOKIE_SECURE=true
FULLPRO_PUBLIC_BASE_URL=https://tab.kekeio.com
FULLPRO_ADMIN_ALLOWED_CIDRS=127.0.0.1/32,::1/128,192.168.50.0/24
FULLPRO_AUTH_RATE_LIMIT=20
FULLPRO_AUTH_RATE_WINDOW_SECONDS=60
FULLPRO_PASSWORD_HASH_CONCURRENCY=2

# Optional startup override. Leave unset to use the exact origins saved by the
# installation wizard. Setting it replaces the persisted list.
# FULLPRO_API_ALLOWED_ORIGINS=chrome-extension://<extension-id>,https://app.example.com

# Set this only to the exact reverse-proxy IP or smallest controlled CIDR.
# Container-to-container proxies are not loopback connections.
# FULLPRO_TRUSTED_PROXIES=172.30.88.2/32
