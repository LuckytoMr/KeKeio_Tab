# 必填：使用 Actions/Release 中实际发布的 v*、sha-* 或本地离线标签。
# 导入 kekeio-tab-router-arm64.tar 或 kekeio-tab-docker-arm64.tar 后填写 kekeio-tab:arm64。
# 生产环境不要使用浮动 latest。
KEKEIO_IMAGE=
KEKEIO_CADDY_IMAGE=caddy:2.11.4-alpine
KEKEIO_CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.3

# 正式扩展固定访问该公网域名；除非同时重建扩展，否则不要修改。
KEKEIO_DOMAIN=tab.kekeio.com

# Tunnel 模式的局域网安装/管理地址。填写路由器真实 LAN IP，
# 管理浏览器访问 https://该IP:8443，并信任 Caddy 本地 CA。
KEKEIO_ADMIN_HOST=192.168.50.1

# 使用支持 SQLite 锁、WAL、原子 rename 和 Unix 权限的本地 Linux 文件系统，优先 ext4。
KEKEIO_DATA_DIR=/mnt/usb-24aeefbb/mi_docker/tab/data
KEKEIO_BACKUP_DIR=/mnt/usb-24aeefbb/mi_docker/tab/backups

# Tunnel 模式仅绑定真实 LAN 地址，不做 WAN 端口转发。
# 直连模式如确实需要所有接口监听，必须自行显式改成 0.0.0.0 并配置防火墙。
KEKEIO_HTTP_BIND=192.168.50.1
KEKEIO_HTTP_PORT=8080
KEKEIO_HTTPS_BIND=192.168.50.1
KEKEIO_HTTPS_PORT=8443

# 仅供 compose.host-proxy.yaml 使用；Docker 28 以下不能把 localhost 发布当成可靠隔离。
KEKEIO_BACKEND_BIND=127.0.0.1
KEKEIO_BACKEND_PORT=9009

# Caddy 使用空格分隔，Go 后端使用逗号分隔。两者都必须收窄到真实管理 LAN/VLAN。
# 不要加入 172.17.0.0/16、Docker 子网、cloudflared 地址或任意私网大网段。
KEKEIO_ADMIN_NETWORKS=192.168.50.0/24
KEKEIO_ADMIN_ALLOWED_CIDRS=127.0.0.1/32,::1/128,192.168.50.0/24

# 自定义 bridge 网段不得与 LAN、VPN 或其他 Docker 网络重叠。
KEKEIO_DOCKER_SUBNET=172.30.88.0/29
KEKEIO_CADDY_IP=172.30.88.2
KEKEIO_BACKEND_IP=172.30.88.3
KEKEIO_CLOUDFLARED_IP=172.30.88.4
KEKEIO_TRUSTED_PROXIES=172.30.88.2/32

# 新 Tunnel Token 只保存到路由器本地文件；该值是文件路径，不是 Token。
KEKEIO_CLOUDFLARED_TOKEN_FILE=/mnt/usb-24aeefbb/mi_docker/tab/secrets/cloudflare-tunnel-token

# 生成 256 位随机值并拆成两个 DNS 标签，例如 origin-<前32位>.<后32位>.invalid。
# Cloudflare 的 HTTP Host Header 和 Caddy 必须使用同一值，用于拒绝绕过 Tunnel 的直连请求。
KEKEIO_TUNNEL_ORIGIN_HOST=

# 仅 compose.tunnel-simpledocker.yaml 使用。先用 docker network inspect bridge
# 查出实际 Gateway 再填写，不能假定每台设备都是 172.17.0.1。
KEKEIO_TUNNEL_ORIGIN_BIND=172.17.0.1
KEKEIO_TUNNEL_ORIGIN_PORT=18081
