# REQUIRED. Published images support linux/amd64 and linux/arm64.
# Fill this with an actually published v* tag or the sha-<full-commit> tag
# produced by Actions. It is intentionally empty so a missing choice fails
# before Compose pulls anything. Do not use floating latest in production.
KEKEIO_IMAGE=
KEKEIO_CADDY_IMAGE=caddy:2.11.4-alpine

# The official extension is compiled for this exact origin. Do not change it
# unless you are also building a fork of the extension with a new endpoint.
KEKEIO_DOMAIN=tab.kekeio.com

# Use separate, local Linux filesystem directories. Create them as UID/GID
# 10001 before starting the containers.
KEKEIO_DATA_DIR=/mnt/usb-24aeefbb/kekeio-tab/data
KEKEIO_BACKUP_DIR=/mnt/usb-24aeefbb/kekeio-tab/backups

# High host ports avoid collisions with a router management UI. Forward WAN
# TCP 80 -> 8080 and TCP 443 -> 8443. UDP 443 -> 8443 is optional for HTTP/3.
KEKEIO_HTTP_BIND=0.0.0.0
KEKEIO_HTTP_PORT=8080
KEKEIO_HTTPS_BIND=0.0.0.0
KEKEIO_HTTPS_PORT=8443

# Backend 8881 is not published by the default Compose file. These values are
# only used with compose.host-proxy.yaml and must never be WAN-forwarded.
KEKEIO_BACKEND_BIND=127.0.0.1
KEKEIO_BACKEND_PORT=8881

# Caddy uses space-separated CIDRs; the Go backend uses comma-separated CIDRs.
# Narrow these values to the real LAN/VLAN prefixes that may manage the service.
KEKEIO_ADMIN_NETWORKS=192.168.50.0/24
KEKEIO_ADMIN_ALLOWED_CIDRS=127.0.0.1/32,::1/128,192.168.50.0/24

# Change this /29 if it overlaps a LAN, VPN, or another Docker network. Keep
# both static service addresses inside the selected subnet.
KEKEIO_DOCKER_SUBNET=172.30.88.0/29
KEKEIO_CADDY_IP=172.30.88.2
KEKEIO_BACKEND_IP=172.30.88.3
KEKEIO_TRUSTED_PROXIES=172.30.88.2/32
